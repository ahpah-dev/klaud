# Normalise line endings so the repository is stable across platforms.
# Git's default on Windows rewrites LF to CRLF in the working copy, which makes
# every file look modified after a fresh clone.
* text=auto eol=lf

# Windows launcher must keep CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts must keep LF, or macOS and Linux refuse to run them.
*.sh text eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
